@model ProductEditModel
@{ViewData["Title"]=Model.Id==0?"Add product":"Edit product";}<a asp-action="Index">← Products</a><h1>@ViewData["Title"]</h1><form method="post" class="admin-form"><input asp-for="Id" type="hidden"/><input asp-for="StockVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Name<input asp-for="Name"/><span asp-validation-for="Name"></span></label><label>Slug<input asp-for="Slug"/><span asp-validation-for="Slug"></span></label><label>SKU<input asp-for="Sku"/><span asp-validation-for="Sku"></span></label><label>Category<select asp-for="CategoryId">@foreach(Category c in ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="CategoryId"></span></label><label>Price<input asp-for="Price"/><span asp-validation-for="Price"></span></label><label>Stock quantity<input asp-for="StockQuantity"/><span asp-validation-for="StockQuantity"></span></label><label>Primary local image<select asp-for="ImagePath">@foreach(string image in ViewBag.Images){<option value="@image">@image</option>}</select><span asp-validation-for="ImagePath"></span></label><label>Secondary local image<select asp-for="SecondaryImagePath"><option value="">None</option>@foreach(string image in ViewBag.SecondaryImages){<option value="@image">@image</option>}</select><span asp-validation-for="SecondaryImagePath"></span></label></div><label>Short description<textarea asp-for="ShortDescription"></textarea><span asp-validation-for="ShortDescription"></span></label><label>Description<textarea asp-for="Description" rows="6"></textarea><span asp-validation-for="Description"></span></label><div class="actions"><label class="check"><input asp-for="IsActive"/> Active</label><label class="check"><input asp-for="IsFeatured"/> Featured</label></div><button class="button">Save product</button></form>
