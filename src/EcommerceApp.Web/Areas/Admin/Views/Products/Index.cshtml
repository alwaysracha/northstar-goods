@model IReadOnlyList<Product>
@{ViewData["Title"]="Products";}<div class="admin-title"><div><p class="eyebrow">Catalog & inventory</p><h1>Products</h1></div><a class="button" asp-action="Create">Add product</a></div><form method="get" class="admin-filter"><input name="search" value="@ViewBag.Search" placeholder="Search name or SKU"/><button>Search</button></form><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>SKU</th><th>Price</th><th>Stock</th><th>State</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Name</strong>@if(x.IsFeatured){<small>Featured</small>}</td><td>@x.Category.Name</td><td>@x.Sku</td><td>@x.Price.ToString("C")</td><td class="@(x.StockQuantity<=5?"danger":"")">@x.StockQuantity</td><td>@(x.IsActive?"Active":"Inactive")</td><td class="actions"><a asp-action="Edit" asp-route-id="@x.Id">Edit</a><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="link-button danger" onclick="return confirm('Delete or deactivate this product?')">Delete</button></form></td></tr>}</tbody></table></div>
