@model IReadOnlyList<Category>
@{ViewData["Title"]="Categories";}<div class="admin-title"><div><p class="eyebrow">Catalog</p><h1>Categories</h1></div><a class="button" asp-action="Create">Add category</a></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th>Products</th><th>State</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Name</strong></td><td>@x.Slug</td><td>@x.Products.Count</td><td>@(x.IsActive?"Active":"Inactive")</td><td class="actions"><a asp-action="Edit" asp-route-id="@x.Id">Edit</a><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="link-button danger" onclick="return confirm('Delete this category?')">Delete</button></form></td></tr>}</tbody></table></div>
