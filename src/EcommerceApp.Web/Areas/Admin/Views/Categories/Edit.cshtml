@model CategoryEditModel
@{ViewData["Title"]=Model.Id==0?"Add category":"Edit category";}<a asp-action="Index">← Categories</a><h1>@ViewData["Title"]</h1><form method="post" class="admin-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Name<input asp-for="Name"/><span asp-validation-for="Name"></span></label><label>Slug<input asp-for="Slug"/><span asp-validation-for="Slug"></span></label><label>Display order<input asp-for="DisplayOrder"/><span asp-validation-for="DisplayOrder"></span></label><label>Local image<select asp-for="ImagePath">@foreach(string image in ViewBag.Images){<option value="@image">@image</option>}</select><span asp-validation-for="ImagePath"></span></label></div><label>Description<textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description"></span></label><label class="check"><input asp-for="IsActive"/> Active</label><button class="button">Save category</button></form>
