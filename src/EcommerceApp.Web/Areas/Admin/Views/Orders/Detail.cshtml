@model Order
@{ViewData["Title"]=$"Order {Model.OrderNumber}";}<a asp-action="Index">← Orders</a><div class="admin-title"><div><p class="eyebrow">Order detail</p><h1>@Model.OrderNumber</h1></div><span class="status">@Model.Status</span></div><div class="admin-grid"><section class="panel"><h2>Items</h2>@foreach(var item in Model.Items){<div class="line"><span><strong>@item.ProductName</strong><small>@item.Sku · Qty @item.Quantity</small></span><strong>@((item.UnitPrice*item.Quantity).ToString("C"))</strong></div>}<h2>Customer & shipping</h2><p>@Model.ContactEmail<br/>@Model.RecipientName<br/>@Model.ShippingAddress</p></section><aside><section class="summary"><div><span>Subtotal</span><strong>@Model.Subtotal.ToString("C")</strong></div><div><span>Discount</span><strong>−@Model.DiscountTotal.ToString("C")</strong></div><div><span>Shipping</span><strong>@Model.ShippingTotal.ToString("C")</strong></div><div class="total"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div></section><section class="panel"><h2>Update status</h2>@if(((IReadOnlyList<OrderStatus>)ViewBag.NextStatuses).Count==0){<p>This order is in a final state.</p>}else{<form asp-action="Status" asp-route-id="@Model.Id" method="post"><input type="hidden" name="OriginalStatus" value="@Model.Status"/><select name="Status">@foreach(var status in (IReadOnlyList<OrderStatus>)ViewBag.NextStatuses){<option value="@status">@status</option>}</select><button class="button">Update status</button></form>}</section></aside></div>
