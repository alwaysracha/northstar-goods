@model IReadOnlyList<Order>
@{ViewData["Title"]="Orders";}<div class="admin-title"><div><p class="eyebrow">Fulfillment</p><h1>Orders</h1></div></div><form method="get" class="admin-filter"><input name="search" value="@ViewBag.Search" placeholder="Order number or email"/><select name="status"><option value="">All statuses</option>@foreach(var s in Enum.GetValues<OrderStatus>()){<option value="@s">@s</option>}</select><button>Filter</button></form><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="Detail" asp-route-id="@x.Id"><strong>@x.OrderNumber</strong></a></td><td>@x.ContactEmail</td><td>@x.CreatedAt.ToString("MMM d, yyyy")</td><td>@x.Items.Sum(i=>i.Quantity)</td><td>@x.Total.ToString("C")</td><td><span class="status">@x.Status</span></td></tr>}</tbody></table></div>
