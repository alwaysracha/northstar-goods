@model DashboardModel
@{ViewData["Title"]="Admin dashboard";}<p class="eyebrow">Operations overview</p><div class="admin-title"><h1>Admin dashboard</h1><span>@DateTimeOffset.Now.ToString("MMM d, yyyy")</span></div><div class="stat-grid"><article><span>Orders</span><strong>@Model.Orders</strong></article><article><span>Revenue</span><strong>@Model.Revenue.ToString("C0")</strong></article><article><span>Active products</span><strong>@Model.ActiveProducts</strong></article><article><span>Low stock</span><strong>@Model.LowStockProducts</strong></article><article><span>Categories</span><strong>@Model.Categories</strong></article><article><span>Customers</span><strong>@Model.Customers</strong></article></div><section class="panel"><h2>Quick actions</h2><div class="actions"><a class="button" asp-controller="Products" asp-action="Create">Add product</a><a class="button secondary" asp-controller="Orders">Review orders</a><a class="button secondary" asp-controller="Discounts" asp-action="Create">Create discount</a></div></section>
