@model DiscountEditModel
@{ViewData["Title"]=Model.Id==0?"Add discount":"Edit discount";}<a asp-action="Index">← Discounts</a><h1>@ViewData["Title"]</h1><form method="post" class="admin-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Code<input asp-for="Code"/><span asp-validation-for="Code"></span></label><label>Kind<select asp-for="Kind" asp-items="Html.GetEnumSelectList<DiscountKind>()"></select></label><label>Value<input asp-for="Value"/><span asp-validation-for="Value"></span></label><label>Minimum subtotal<input asp-for="MinimumSubtotal"/><span asp-validation-for="MinimumSubtotal"></span></label><label>Maximum discount<input asp-for="MaximumDiscount"/><span asp-validation-for="MaximumDiscount"></span></label><label>Usage limit<input asp-for="UsageLimit"/><span asp-validation-for="UsageLimit"></span></label><label>Starts at<input asp-for="StartsAt"/><span asp-validation-for="StartsAt"></span></label><label>Ends at<input asp-for="EndsAt"/><span asp-validation-for="EndsAt"></span></label></div><label class="check"><input asp-for="IsActive"/> Active</label><button class="button">Save discount</button></form>
