@model IReadOnlyList<DiscountCode>
@{ViewData["Title"]="Discounts";}<div class="admin-title"><div><p class="eyebrow">Promotions</p><h1>Discounts</h1></div><a class="button" asp-action="Create">Add discount</a></div><div class="table-wrap"><table><thead><tr><th>Code</th><th>Offer</th><th>Window</th><th>Usage</th><th>State</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Code</strong></td><td>@x.Value.ToString("0.##") @(x.Kind==DiscountKind.Percentage?"%":"fixed")</td><td>@x.StartsAt.ToString("MMM d") – @x.EndsAt.ToString("MMM d, yyyy")</td><td>@x.Redemptions.Count / @(x.UsageLimit?.ToString()??"∞")</td><td>@(x.IsActive?"Active":"Inactive")</td><td class="actions"><a asp-action="Edit" asp-route-id="@x.Id">Edit</a><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button class="link-button danger" onclick="return confirm('Delete this discount?')">Delete</button></form></td></tr>}</tbody></table></div>
