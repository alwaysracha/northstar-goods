<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] — Northstar Admin</title><link rel="icon" type="image/svg+xml" href="~/favicon.svg"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="admin-body"><a class="skip-link" href="#admin-main">Skip to content</a><header class="admin-header"><a class="brand" asp-area="Admin" asp-controller="Home" asp-action="Index">✦ NORTHSTAR <small>ADMIN</small></a><button type="button" class="admin-menu" aria-controls="admin-nav">Menu</button><nav id="admin-nav"><a asp-area="Admin" asp-controller="Home">Dashboard</a><a asp-area="Admin" asp-controller="Categories">Categories</a><a asp-area="Admin" asp-controller="Products">Products</a><a asp-area="Admin" asp-controller="Discounts">Discounts</a><a asp-area="Admin" asp-controller="Orders">Orders</a><a asp-area="" asp-controller="Home">View store</a></nav></header><main id="admin-main" class="admin-shell">@if(TempData["Notice"] is string n){<div class="flash success">@n</div>}@if(TempData["Error"] is string e){<div class="flash error">@e</div>}@RenderBody()</main><script src="~/js/site.js" asp-append-version="true"></script></body></html>
