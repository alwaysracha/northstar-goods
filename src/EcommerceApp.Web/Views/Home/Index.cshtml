@model HomeViewModel
@{ ViewData["Title"] = "Thoughtful goods for everyday life"; }
<section class="hero">
  <div class="hero-copy"><span class="eyebrow">The considered collection</span><h1>Thoughtful goods.<br/><em>Beautifully useful.</em></h1><p>Enduring pieces selected for everyday rituals, quiet moments, and the spaces between.</p><a class="button" asp-controller="Catalog">Explore the collection <span>→</span></a></div>
  <div class="hero-art"><img src="/images/hero.svg" alt="A curated arrangement of Northstar home goods" /></div>
</section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">Browse by room & ritual</span><h2>Find your corner</h2></div><a asp-controller="Catalog">View everything →</a></div><div class="category-grid">@foreach(var category in Model.Categories){<a class="category-card" asp-controller="Catalog" asp-action="Index" asp-route-category="@category.Slug"><img src="@category.ImagePath" alt="" /><div><h3>@category.Name</h3><span>@category.ProductCount pieces →</span></div></a>}</div></section>
<section class="section tinted"><div class="section-heading"><div><span class="eyebrow">Chosen with care</span><h2>Current favorites</h2></div></div><div class="product-grid">@foreach(var product in Model.Featured){<partial name="_ProductCard" model="product" />}</div></section>
<section class="manifesto"><span class="eyebrow">Our point of view</span><blockquote>“Buy fewer things.<br/>Choose <em>better</em> ones.”</blockquote><p>We seek useful objects with a clear purpose, honest materials, and a lasting place in your home.</p></section>
