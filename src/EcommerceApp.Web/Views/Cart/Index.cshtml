@model EcommerceApp.Web.ViewModels.CartPage
@{ ViewData["Title"] = "Your bag"; }
<section class="page-shell"><span class="eyebrow">Your selection</span><h1>Your bag</h1>@if (!Model.Cart.Items.Any()) { <div class="empty"><h2>Your bag is ready for something good.</h2><a class="button" asp-controller="Catalog" asp-action="Index">Browse the collection</a></div> } else { <div class="cart-layout"><div class="cart-lines">@foreach(var item in Model.Cart.Items){<article class="cart-line"><img src="@item.ImagePath" alt=""/><div><h2><a asp-controller="Catalog" asp-action="Detail" asp-route-slug="@item.Slug">@item.Name</a></h2><p>@item.UnitPrice.ToString("C") each</p>@if(!item.Available){<p class="validation">No longer available</p>}</div><form asp-action="Update" method="post"><input type="hidden" name="productId" value="@item.ProductId"/><label>Quantity<input name="quantity" type="number" min="0" max="@item.Stock" value="@item.Quantity"/></label><button>Update</button></form><strong>@item.LineTotal.ToString("C")</strong><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId"/><button class="link-button">Remove</button></form></article>}</div><aside class="summary"><h2>Order summary</h2><div><span>Subtotal</span><strong>@Model.Cart.Subtotal.ToString("C")</strong></div>@if(Model.Discount > 0){<div><span>Discount</span><strong>−@Model.Discount.ToString("C")</strong></div>}<div class="total"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div><form asp-action="ApplyDiscount" method="post"><label for="code">Discount code</label><div class="inline"><input id="code" name="code" value="@Model.Cart.DiscountCode"/><button>Apply</button></div></form><a class="button" asp-controller="Checkout" asp-action="Index">Continue to checkout</a></aside></div>}</section>
