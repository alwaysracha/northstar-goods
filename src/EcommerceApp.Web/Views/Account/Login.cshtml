@model EcommerceApp.Web.ViewModels.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<section class="account-shell"><div class="form-card"><span class="eyebrow">Welcome back</span><h1>Sign in</h1><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password"/><span asp-validation-for="Password"></span><label class="check"><input asp-for="RememberMe"/> Keep me signed in</label><button class="button">Sign in</button></form><p>New here? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p></div></section>
