@model EcommerceApp.Web.ViewModels.RegisterModel
@{ ViewData["Title"] = "Create account"; }
<section class="account-shell"><div class="form-card"><span class="eyebrow">Join Northstar</span><h1>Create your account</h1><p>Save your cart and move through checkout with ease.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="DisplayName"></label><input asp-for="DisplayName" autocomplete="name"/><span asp-validation-for="DisplayName"></span><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password"/><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span><button class="button">Create account</button></form><p>Already with us? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p></div></section>
