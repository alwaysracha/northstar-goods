@model PagedCatalog
@{ ViewData["Title"] = "Shop the collection"; var categories = (IReadOnlyList<CategoryCard>)ViewBag.Categories; }
<section class="catalog-head"><span class="eyebrow">The full collection</span><h1>Objects worth keeping</h1><p>Useful, enduring pieces for home, work, and wherever the day takes you.</p></section>
<div class="catalog-layout">
<aside><form method="get" class="filters"><h2>Refine</h2><label>Search<input name="search" value="@Model.Query.Search" placeholder="Name, description, SKU" /></label><label>Category<select name="category"><option value="">All categories</option>@foreach(var c in categories){<option value="@c.Slug" selected="@(Model.Query.Category == c.Slug)">@c.Name</option>}</select></label><div class="price-inputs"><label>Min price<input type="number" name="minPrice" min="0" step="1" value="@Model.Query.MinPrice" /></label><label>Max price<input type="number" name="maxPrice" min="0" step="1" value="@Model.Query.MaxPrice" /></label></div><label class="check"><input type="checkbox" name="inStockOnly" value="true" checked="@Model.Query.InStockOnly" /> In stock only</label><button class="button" type="submit">Apply filters</button><a asp-action="Index">Clear all</a></form></aside>
<section class="results" aria-live="polite"><div class="results-bar"><strong>@Model.Total products found</strong><form method="get"><input type="hidden" name="search" value="@Model.Query.Search"/><input type="hidden" name="category" value="@Model.Query.Category"/><input type="hidden" name="minPrice" value="@Model.Query.MinPrice"/><input type="hidden" name="maxPrice" value="@Model.Query.MaxPrice"/><input type="hidden" name="inStockOnly" value="@Model.Query.InStockOnly.ToString().ToLowerInvariant()"/><input type="hidden" name="pageSize" value="@Model.Query.PageSize"/><label>Sort <select name="sort" onchange="this.form.submit()"><option value="featured" selected="@(Model.Query.Sort == "featured")">Featured</option><option value="newest" selected="@(Model.Query.Sort == "newest")">Newest</option><option value="price-asc" selected="@(Model.Query.Sort == "price-asc")">Price: low to high</option><option value="price-desc" selected="@(Model.Query.Sort == "price-desc")">Price: high to low</option><option value="name" selected="@(Model.Query.Sort == "name")">Name</option></select></label></form></div>
@if(Model.Items.Count == 0){<div class="empty"><h2>No pieces found</h2><p>Try removing a filter or searching for something broader.</p><a class="button" asp-action="Index">See all products</a></div>}else{<div class="product-grid">@foreach(var product in Model.Items){<partial name="_ProductCard" model="product" />}</div><nav class="pagination" aria-label="Catalog pages">@for(var i=1;i<=Model.TotalPages;i++){<a class="@(i == Model.Page ? "active" : "")" asp-route-page="@i" asp-route-search="@Model.Query.Search" asp-route-category="@Model.Query.Category" asp-route-minPrice="@Model.Query.MinPrice" asp-route-maxPrice="@Model.Query.MaxPrice" asp-route-inStockOnly="@Model.Query.InStockOnly" asp-route-pageSize="@Model.Query.PageSize" asp-route-sort="@Model.Query.Sort" aria-current="@(i == Model.Page ? "page" : null)">@i</a>}</nav>}</section></div>
