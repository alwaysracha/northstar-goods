@model ProductDetail
@{ ViewData["Title"] = Model.Name; }
<div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span><a asp-action="Index" asp-route-category="@Model.Category.ToLowerInvariant()">@Model.Category</a><span>/</span><span>@Model.Name</span></div>
<article class="detail"><div class="gallery"><img class="main-image" src="@Model.ImagePath" alt="@Model.Name" /><img src="@Model.SecondaryImagePath" alt="@Model.Name shown with its collection" /></div><div class="detail-copy"><span class="eyebrow">@Model.Category · @Model.Sku</span><h1>@Model.Name</h1><p class="detail-price">@Model.Price.ToString("C")</p><p class="lede">@Model.Summary</p><div class="inventory @(Model.Stock > 0 ? "" : "out")"><span></span>@(Model.Stock > 5 ? "Ready to ship" : Model.Stock > 0 ? $"Only {Model.Stock} left" : "Currently unavailable")</div><p>@Model.Description</p><form class="add-control" asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><label>Quantity<input name="quantity" type="number" min="1" max="@Model.Stock" value="1"/></label><button class="button" disabled="@(Model.Stock < 1)">@(Model.Stock > 0 ? "Add to bag" : "Unavailable")</button></form><dl><div><dt>Materials</dt><dd>Chosen for durability and everyday use</dd></div><div><dt>Delivery</dt><dd>Free ground shipping over $100</dd></div><div><dt>Care</dt><dd>Simple care guidance included</dd></div></dl></div></article>
