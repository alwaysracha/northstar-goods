@model EcommerceApp.Web.Domain.Entities.Order
@{ ViewData["Title"] = "Order confirmed"; }
<section class="confirmation"><span class="confirmation-mark" aria-hidden="true">✓</span><span class="eyebrow">Order @Model.OrderNumber</span><h1>Thank you, @Model.RecipientName.</h1><p>Your simulated payment was accepted and your order is confirmed. A demo receipt would be sent to <strong>@Model.ContactEmail</strong>.</p><div class="summary confirmation-summary">@foreach(var item in Model.Items){<div><span>@item.ProductName × @item.Quantity</span><strong>@((item.UnitPrice * item.Quantity).ToString("C"))</strong></div>}<div class="total"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div></div><p class="muted">Shipping to:<br/>@Html.Raw(System.Net.WebUtility.HtmlEncode(Model.ShippingAddress).Replace("\n", "<br/>"))</p><a class="button" asp-controller="Catalog">Continue shopping</a></section>
