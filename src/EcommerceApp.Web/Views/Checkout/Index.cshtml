@model EcommerceApp.Web.ViewModels.CheckoutModel
@{ ViewData["Title"] = "Checkout"; }
<section class="page-shell"><span class="eyebrow">Secure local checkout</span><h1>Where should we send it?</h1><div class="checkout-layout"><form class="form-card checkout-form" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="CheckoutToken" type="hidden"/><h2>Contact</h2><label asp-for="ContactEmail"></label><input asp-for="ContactEmail" autocomplete="email"/><span asp-validation-for="ContactEmail"></span><h2>Shipping address</h2><label asp-for="RecipientName"></label><input asp-for="RecipientName" autocomplete="name"/><span asp-validation-for="RecipientName"></span><label asp-for="Line1">Address</label><input asp-for="Line1" autocomplete="address-line1"/><span asp-validation-for="Line1"></span><label asp-for="Line2">Apartment, suite, etc. (optional)</label><input asp-for="Line2" autocomplete="address-line2"/><div class="form-grid"><div><label asp-for="City"></label><input asp-for="City" autocomplete="address-level2"/></div><div><label asp-for="Region">State / region</label><input asp-for="Region" autocomplete="address-level1"/></div><div><label asp-for="PostalCode">Postal code</label><input asp-for="PostalCode" autocomplete="postal-code"/></div><div><label asp-for="CountryCode">Country code</label><input asp-for="CountryCode" autocomplete="country" maxlength="2"/></div></div><h2>Payment</h2><label class="payment-option"><input type="radio" asp-for="PaymentMethod" value="simulated" checked/><span><strong>Simulated payment</strong><small>For this local demo only. No card or payment credentials are requested or stored.</small></span></label><button class="button" type="submit">Place order · @Model.Total.ToString("C")</button></form><aside class="summary"><h2>Your order</h2>@foreach(var item in Model.Cart!.Items){<div><span>@item.Name × @item.Quantity</span><strong>@item.LineTotal.ToString("C")</strong></div>}<div><span>Subtotal</span><strong>@Model.Cart.Subtotal.ToString("C")</strong></div>@if(Model.Discount > 0){<div><span>Discount</span><strong>−@Model.Discount.ToString("C")</strong></div>}<div><span>Shipping</span><strong>@(Model.Shipping == 0 ? "Free" : Model.Shipping.ToString("C"))</strong></div><div class="total"><span>Total</span><strong>@Model.Total.ToString("C")</strong></div></aside></div></section>
